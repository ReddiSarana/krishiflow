# ==============================================================
# KrishiFlow (AgriSlot) Environment Variables Configuration
# ==============================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Database Configuration (MongoDB Atlas)
# Free Tier M0 URI: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/
MONGODB_URI=
MONGODB_DB_NAME=krishiflow_db

# Cache & Distributed Locking (Upstash Redis)
# Free Serverless Redis URI: rediss://default:xxxxx@xxxxx.upstash.io:6379
UPSTASH_REDIS_URL=

# Twilio SMS Credentials (Optional for live SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp Cloud API Credentials (Optional for live WhatsApp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Frontend Web Origin URL (for CORS)
FRONTEND_URL=https://krishiflow.vercel.app
